# Requires HF token for gated/private downloads.
# Export HF_TOKEN/HUGGING_FACE_HUB_TOKEN in runtime environment.
# Uses conditional assignment (:=) so real environment variables (e.g. from
# docker-compose.yml) always take precedence over these fallback defaults.
: "${MODEL_NAME:=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ}"
: "${MAX_MODEL_LEN:=32768}"
: "${GPU_MEMORY_UTILIZATION:=0.85}"
: "${QUANTIZATION:=awq}"
: "${PORT:=8001}"
: "${HOST:=0.0.0.0}"
export MODEL_NAME MAX_MODEL_LEN GPU_MEMORY_UTILIZATION QUANTIZATION PORT HOST
