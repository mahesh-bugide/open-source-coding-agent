APP_NAME=enterprise-ai-coding-agent-api
APP_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

DEV_API_KEY=dev-local-key
REQUIRE_API_KEY=true

POSTGRES_DSN=postgresql+psycopg://agent:agent@localhost:5432/agentdb
REDIS_URL=redis://localhost:6379/0

MODEL_MODE=mock
MODEL_BASE_URL=http://localhost:8001/v1
MODEL_API_KEY=
MODEL_NAME=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8

MAX_AGENT_ITERATIONS=6
MAX_AGENT_SECONDS=600
TOOL_DEFAULT_TIMEOUT_SECONDS=60

SANDBOX_MODE=local
SANDBOX_IMAGE=enterprise-agent-sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=1024
SANDBOX_PIDS_LIMIT=256
SANDBOX_DISK_LIMIT_MB=2048
SANDBOX_NETWORK_DISABLED=true

ALLOWED_WORKSPACE_ROOT=
