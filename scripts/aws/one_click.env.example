# Copy this file to scripts/aws/one_click.env and edit values.
# Used by scripts/aws/render_user_data.sh and scripts/aws/build_and_push_ecr.sh.

AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=123456789012
API_REPO=enterprise-api
VLLM_REPO=enterprise-vllm
IMAGE_TAG=v1

# Runtime settings
MODEL_NAME=Qwen/Qwen2.5-Coder-1.5B-Instruct
API_KEY=dev-local-key
HF_TOKEN=
WORKSPACE_PATH=/opt/coding-agent
GIT_REPO_URL=

# Ports
API_PORT=8080
VLLM_PORT=8001
